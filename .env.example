# Set on Netlify (non-public scope) — NOT prefixed NEXT_PUBLIC_
JWT_SECRET=               # 32+ random bytes, e.g. `openssl rand -base64 48`
ADMIN_EMAIL=              # owner's chosen admin login email
ADMIN_SEED_PASSWORD=      # owner's chosen plaintext password — used ONCE by the seed script, never stored
# NETLIFY_DATABASE_URL is auto-injected by `netlify database init` — do not set here
# RESEND_API_KEY is already set on Netlify for the transactional email integration
